# The HTTP/1.1 references, pinned, in one image.
#
# Three independent implementations of the message syntax this library
# parses, none of them sharing a line with another:
#
#   llhttp   C, generated from a state-machine description; the parser inside
#            Node. Reached through Node's HTTPParser binding, with the lenient
#            flags off and a control that shows them off (ref-llhttp.js).
#   h11      Python, sans-I/O, written separately from every other parser here.
#   go       Go's net/http: ReadRequest and ReadResponse and the body framing
#            behind them. Compiled in the first stage and copied in, so the
#            image that answers carries no toolchain.
#
# Counted by implementation, not by name: Node's `http` module, curl's
# libcurl-over-llhttp wrappers and any proxy built on llhttp would all be
# llhttp, and are not a fourth. CPython's http.client is a separate
# implementation but reads responses only, and http.server's request reader
# stops at the head; it is left out rather than included as a half-reference.
# nginx is a fourth parser with no way to ask it for the parsed message, only
# for a status; left out for the same reason (notes/http/README.md).
#
# One image, because a disagreement between two of them should be a fact about
# those two parsers and not about two builds (the model and compress images
# say the same).
#
# Everything the build reads is pinned. An image built here cannot be pinned by
# digest - two builds of one Containerfile are not two copies of one image - so
# the base is pinned by digest, Debian's packages by full apt version resolved
# against a dated snapshot of the archive (so the pins do not expire), and h11
# by exact PyPI version (a release is immutable). The version each reference
# prints when it runs is the real guarantee, which is why oracle_env.check_pin()
# runs in both modes.
#
# The snapshot is the one the base image itself records in its own
# debian.sources, as in the suite's other images. The URL is http because the
# slim base carries no CA certificates; apt verifies by signature either way.
# Check-Valid-Until is off because a dated Release file is stale by design.
ARG BASE=docker.io/library/debian@sha256:7792b1f7702a86946cd518db72b6a407302c3e9bc1635634368b878189e8221c
ARG SNAPSHOT=20260918T000000Z

FROM ${BASE} AS gobuild
ARG SNAPSHOT
RUN printf 'Types: deb\nURIs: http://snapshot.debian.org/archive/debian/%s\nSuites: trixie trixie-updates\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.pgp\n\nTypes: deb\nURIs: http://snapshot.debian.org/archive/debian-security/%s\nSuites: trixie-security\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.pgp\n' \
      "$SNAPSHOT" "$SNAPSHOT" > /etc/apt/sources.list.d/debian.sources \
    && printf 'Acquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/99snapshot \
    && apt-get update -qq \
    && apt-get install -y --no-install-recommends golang-1.24-go=1.24.4-1 \
    && rm -rf /var/lib/apt/lists/*
COPY go/main.go /src/main.go
RUN cd /src && CGO_ENABLED=0 GOFLAGS=-trimpath GO111MODULE=off \
    /usr/lib/go-1.24/bin/go build -o /out/ref-go main.go

FROM ${BASE}
ARG SNAPSHOT
RUN printf 'Types: deb\nURIs: http://snapshot.debian.org/archive/debian/%s\nSuites: trixie trixie-updates\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.pgp\n\nTypes: deb\nURIs: http://snapshot.debian.org/archive/debian-security/%s\nSuites: trixie-security\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.pgp\n' \
      "$SNAPSHOT" "$SNAPSHOT" > /etc/apt/sources.list.d/debian.sources \
    && printf 'Acquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/99snapshot

# nodejs   the llhttp reference; Debian's node is built with the llhttp it
#          ships, and process.versions.llhttp is what the probe reports
# python3  runs h11 and the drivers' own protocol
RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends \
      nodejs=20.19.2+dfsg-1+deb13u2 \
      python3=3.13.5-1 \
      python3-pip=25.1.1+dfsg-1 \
      ca-certificates=20250419 \
    && rm -rf /var/lib/apt/lists/*

# h11 0.16.0 and not Debian's python3-h11 0.14.0. 0.14.0 accepts a chunk body
# whose terminator is a bare LF (CVE-2025-43859, fixed in 0.16.0): a reference
# with that defect would score a strictness this library has as a disagreement
# in the wrong direction. Pinned exactly; PyPI releases are immutable.
RUN pip install --no-cache-dir --no-compile --break-system-packages h11==0.16.0

COPY --from=gobuild /out/ref-go /usr/local/bin/ref-go
COPY ref-llhttp.js ref-h11.py /usr/local/lib/ghttp-ref/
COPY llhttp-version h11-version go-version /usr/local/bin/
RUN chmod +x /usr/local/bin/llhttp-version /usr/local/bin/h11-version \
      /usr/local/bin/go-version /usr/local/bin/ref-go

ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 PYTHONDONTWRITEBYTECODE=1 NODE_OPTIONS=--no-warnings

ENTRYPOINT []
CMD ["sh", "-c", "llhttp-version; h11-version; go-version"]
